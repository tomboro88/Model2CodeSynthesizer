[comment encoding = UTF-8 /]
[**
 * The documentation of the module generate.
 */]
[module generate('http://www.eclipse.org/uml2/5.0.0/UML')]

[import tbo::acceleo::psm::uml::gen::c::files::packageHFile /]
[import tbo::acceleo::psm::uml::gen::c::files::packageCFile /]
[import tbo::acceleo::psm::uml::gen::c::files::packageCMLtxtFile /]
[import tbo::acceleo::psm::uml::gen::c::files::smHFile /]
[import tbo::acceleo::psm::uml::gen::c::files::smCFile /]
[import tbo::acceleo::psm::uml::gen::c::files::event_poolHFile /]
[import tbo::acceleo::psm::uml::gen::c::files::event_poolCFile /]
[import tbo::acceleo::psm::uml::gen::c::files::fifoHFile /]
[import tbo::acceleo::psm::uml::gen::c::files::fifoCFile /]

[**
 * The documentation of the template uml2c.
 * @param aModel
 */]
[template public uml2c(aModel : Model) 
 ?(aModel.nestingPackage.oclIsUndefined())]
[comment @main/]
[generatePackageH(aModel)/]
[generatePackageC(aModel)/]
[generate_package_CMLtxtFile(aModel)/]
[for (aPackage : Package|aModel.eAllContents(Package))]
    [generatePackageH(aPackage)/]
    [generatePackageC(aPackage)/]
    [generate_package_CMLtxtFile(aPackage)/]
[/for]
[if aModel.eAllContents(StateMachine)->notEmpty()]
[generate_smHFile()/]
[generate_smCFile()/]
[generate_sm_package_CMLtxtFile()/]
[generate_event_pool_H()/]
[generate_event_pool_C()/]
[generate_event_pool_package_CMLtxtFile()/]
[generate_fifo_package_CMLtxtFile()/]
[generate_fifo_H()/]
[generate_fifo_C()/]
[/if]
[/template]
