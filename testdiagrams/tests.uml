                <body>p_obj->p_context->b_is_completed = false;
TEST_FAIL_MESSAGE(&quot;Unpredicted event occurred!&quot;);</body>
              </effect>
              <trigger xmi:type="uml:Trigger" xmi:id="_pkSewMpSEfGvmdHKClnHFg"/>
            </transition>
